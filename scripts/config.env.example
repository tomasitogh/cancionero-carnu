# config.env — Credenciales para deploy a GitHub Pages
# Copiá este archivo como "config.env" (en la misma carpeta) y completá los valores.
# IMPORTANTE: no compartir este archivo, tiene tu token de acceso.

GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_USER=tu-usuario-de-github
GITHUB_REPO=cancionero-pjsi
